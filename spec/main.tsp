import "@typespec/http";
import "@typespec/rest";

using TypeSpec.Http;
using TypeSpec.Rest;

/**
 * Calendar Call — сервис бронирования звонков
 *
 * ## Роли
 * - **Владелец календаря** — единственный предустановленный профиль без аутентификации.
 *   Управляет типами событий и просматривает все бронирования.
 * - **Гость** — любой пользователь без регистрации.
 *   Просматривает типы событий и создаёт бронирования на свободные слоты.
 *
 * ## Правила занятости
 * - На одно и то же время нельзя создать две записи, даже для разных типов событий.
 * - Окно записи по умолчанию — 14 дней с текущей даты.
 */
@service(#{
  title: "Calendar Call API",
})
namespace CalendarCall;

// ---------------------------------------------------------------------------
// Модели данных
// ---------------------------------------------------------------------------

/** Тип события (вид встречи), создаваемый владельцем. */
model EventType {
  /** Уникальный идентификатор типа события. */
  id: string;

  /** Название типа события (например, «Консультация»). */
  title: string;

  /** Описание типа события. */
  description?: string;

  /** Длительность встречи в минутах. */
  durationMinutes: int32;
}

/** Временной слот, доступный для бронирования. */
model Slot {
  /** Начало слота (UTC). */
  startTime: utcDateTime;

  /** Конец слота (UTC). */
  endTime: utcDateTime;
}

/** Бронирование встречи. */
model Booking {
  /** Уникальный идентификатор бронирования. */
  id: string;

  /** Идентификатор типа события, на который создано бронирование. */
  eventTypeId: string;

  /** Имя гостя. */
  guestName: string;

  /** Email гостя. */
  guestEmail: string;

  /** Начало встречи (UTC). */
  startTime: utcDateTime;

  /** Конец встречи (UTC). */
  endTime: utcDateTime;

  /** Дата и время создания бронирования. */
  createdAt: utcDateTime;
}

// ---------------------------------------------------------------------------
// Модели запросов
// ---------------------------------------------------------------------------

/** Запрос на создание типа события. */
model EventTypeCreate {
  /** Название типа события. */
  title: string;

  /** Описание типа события. */
  description?: string;

  /** Длительность встречи в минутах. */
  durationMinutes: int32;
}

/** Запрос на обновление типа события. Все поля опциональны. */
model EventTypeUpdate {
  /** Название типа события. */
  title?: string;

  /** Описание типа события. */
  description?: string;

  /** Длительность встречи в минутах. */
  durationMinutes?: int32;
}

/** Запрос на создание бронирования. */
model BookingCreate {
  /** Идентификатор типа события. */
  eventTypeId: string;

  /** Имя гостя. */
  guestName: string;

  /** Email гостя. */
  guestEmail: string;

  /** Начало встречи (UTC). Слот должен быть свободен. */
  startTime: utcDateTime;
}

// ---------------------------------------------------------------------------
// Ответы
// ---------------------------------------------------------------------------

/** Список доступных слотов. */
model SlotsResponse {
  /** Массив доступных временных слотов. */
  slots: Slot[];
}

// ---------------------------------------------------------------------------
// Параметры
// ---------------------------------------------------------------------------

/** Параметры фильтрации слотов по дате. */
model SlotQueryParams {
  /** Начало окна поиска (включительно, формат YYYY-MM-DD). */
  @query
  dateFrom?: string;

  /** Конец окна поиска (включительно, формат YYYY-MM-DD). */
  @query
  dateTo?: string;
}

// ---------------------------------------------------------------------------
// API: Управление типами событий (владелец + гость)
// ---------------------------------------------------------------------------

@route("/api/event-types")
interface EventTypes {
  /** Получить список всех типов событий. Доступно всем. */
  @get
  list(): EventType[];

  /** Создать новый тип события. Только для владельца. */
  @post
  create(@body body: EventTypeCreate): EventType;

  /** Получить тип события по ID. Доступно всем. */
  @get
  get(@path id: string): EventType;

  /** Обновить тип события. Только для владельца. */
  @put
  update(@path id: string, @body body: EventTypeUpdate): EventType;

  /** Удалить тип события. Только для владельца. */
  @delete
  delete(@path id: string): void;
}

// ---------------------------------------------------------------------------
// API: Слоты (гость)
// ---------------------------------------------------------------------------

@route("/api/event-types/{id}")
interface Slots {
  /** Получить свободные слоты для указанного типа события.
   *
   * Если параметры `dateFrom` и `dateTo` не указаны, возвращаются слоты
   * на ближайшие 14 дней от текущей даты.
   */
  @route("slots")
  @get
  listAvailable(@path id: string, @query dateFrom?: string, @query dateTo?: string): SlotsResponse;
}

// ---------------------------------------------------------------------------
// API: Бронирования (владелец + гость)
// ---------------------------------------------------------------------------

@route("/api/bookings")
interface Bookings {
  /** Получить список всех бронирований (предстоящие встречи). Только для владельца. */
  @get
  list(): Booking[];

  /** Создать новое бронирование на свободный слот. Для гостя. */
  @post
  create(@body body: BookingCreate): Booking;
}
